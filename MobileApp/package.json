{
  "name": "legal-terminus-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Capacitor Android shell around the Portal (Portal/dist-mobile).",
  "scripts": {
    "build:web": "cd ../Portal && npm run build:mobile",
    "sync": "npm run build:web && cap sync android",
