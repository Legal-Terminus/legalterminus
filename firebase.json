{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "Frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "legal-terminus-api",
          "region": "asia-south2"
        }
      },
      {
        "source": "/portal/**",
        "run": {
          "serviceId": "legal-terminal-portal",
          "region": "asia-south2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "regex": "^/setting-up-a-business/profit-making-structures/private-limited-company-registration-in-india/?$",
        "destination": "/private-limited-company-registration-in-india",
        "type": 301
      },
      {
        "regex": "^/setting-up-a-business/profit-making-structures/incorporation-of-wholly-owned-subsidiary-in-india/?$",
        "destination": "/incorption-registration-in-india",
        "type": 301
      },
      {
