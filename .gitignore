# Firebase
.firebase/

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*.DS_Store

# Dependencies
node_modules/
*/node_modules/

# Build & Output
dist/
build/

# Environment variables
.env
.env.local
.env.qa
.env.*.local
*.env
*.env.local
!.env.example

# Secrets / credentials / keys
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
*-credentials.json
*.pem
*.key
*.p12

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*
test-output.txt

# Uploads
uploads/
*/uploads/

# OS
.DS_Store
Thumbs.db

# Package managers
package-lock.json
# ...but each app shell's lockfile is tracked: a clean checkout must be able to `npm ci` (release builds)
!iOSApp/package-lock.json
!iOSAppProd/package-lock.json
!AndroidApp/package-lock.json
yarn.lock

# Built frontend (generated by CI pipeline)
backend/public/
__pycache__/

# Capacitor app bundle
Portal/dist-mobile/
AndroidApp/android/app/src/main/assets/public/

# Firebase config for the Android app: downloaded per environment, never committed
AndroidApp/android/app/google-services.json

# E29: the environment switch's outputs (MobileShared/scripts/app-env.mjs) — per build, never committed
iOSApp/.app-env.json
iOSAppProd/.app-env.json
AndroidApp/.app-env.json
iOSApp/ios/App/Config/Environment.xcconfig
iOSAppProd/ios/App/Config/Environment.xcconfig

# E29-S02: the iOS app. Generated or secret; everything else under iOSApp/ios is committed.
iOSApp/ios/App/Pods/
iOSApp/ios/App/build/
iOSApp/ios/App/App/public/
iOSApp/ios/App/App/capacitor.config.json
iOSApp/ios/App/App/config.xml
iOSApp/ios/**/xcuserdata/
iOSApp/ios/**/GoogleService-Info*.plist
iOSApp/ios/DerivedData/
# iOSAppProd/ (production iPhone app): same rules as iOSApp/
iOSAppProd/ios/App/Pods/
iOSAppProd/ios/App/build/
iOSAppProd/ios/App/App/public/
iOSAppProd/ios/App/App/capacitor.config.json
iOSAppProd/ios/App/App/config.xml
iOSAppProd/ios/**/xcuserdata/
iOSAppProd/ios/**/GoogleService-Info*.plist
iOSAppProd/ios/DerivedData/
# Signing material, both platforms (iOSApp/ios/ExportOptions.plist is NOT secret and is kept)
*.mobileprovision
*.p8
*.p12
*.jks
*.keystore
key.properties
