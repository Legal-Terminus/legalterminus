# Backend environment — example. Copy values into .env / .env.qa (gitignored).
# Only the EMAIL block is documented here; Firebase/PayU/etc. are configured
# separately (see your existing .env.qa).

# ─── Email (E07-S02) — Gmail SMTP via Nodemailer + App Password ──────────────
# Sends an email for every in-app notification. If GMAIL_USER / GMAIL_APP_PASSWORD
# are unset, email is a safe no-op (logged, skipped) — nothing breaks.
#
# Setup: in the sending Google account, enable 2-Step Verification, then create an
# "App Password" (Google Account → Security → App passwords) and paste it below.
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM="Legal Terminus <your-sender@gmail.com>"

# Base URL used for deep links in emails (e.g. https://legal-terminus-web.web.app).
# Already used elsewhere; emails link to ${FRONTEND_URL}/portal/tasks/:taskId.
# Defaults to https://legalterminus.com when unset — set this ONLY for local dev
# or a non-production deploy. Do not point it at a *.web.app host in production:
# emails and payment returns would send clients to the wrong domain.
FRONTEND_URL=http://localhost:5174
