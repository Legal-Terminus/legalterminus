rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    // #166: an additional client login acts for the account that OWNS the matters.
    // The link is stamped on the custom claim at provisioning so rules can resolve
    // it without a document read on every check.
    function clientScopeUid() {
      return request.auth.token.primaryClientUid != null
        ? request.auth.token.primaryClientUid
        : request.auth.uid;
    }

    // #168: an external professional reads ONLY the matters naming them.
    function isGrantedProfessional(task) {
      return isSignedIn() && role() == 'professional'
        && task.accessProfessionalUids != null
        && request.auth.uid in task.accessProfessionalUids;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isAdminOrManager() {
      return isSignedIn() && role() in ['admin', 'manager'];
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users/{uid} ────────────────────────────────────────────────────────
    match /users/{uid} {
      // Any authenticated user can read their own profile; admin can read all
      allow read: if isCurrentUser(uid) || isAdmin();
      // Only admin can create/update user records (role management is server-side)
      allow write: if isAdmin();

      // ── users/{uid}/payments/{txnId} ─────────────────────────────────────
      // Payments are stored as a subcollection on the user (written by the
      // backend Admin SDK, which bypasses these rules). The owner may read their
      // own payment history; admin/manager may read all. No client writes.
      match /payments/{txnId} {
        allow read: if isCurrentUser(uid) || isAdminOrManager();
        allow write: if false;
      }
    }

    // ── tasks/{taskId} ─────────────────────────────────────────────────────
    match /tasks/{taskId} {
      // Client can only read tasks where they are the client
      allow read: if isAdminOrManager()
        || (isSignedIn() && role() == 'team_member' && resource.data.assignedTo == request.auth.uid)
        || (isSignedIn() && role() == 'client' && resource.data.clientUid == clientScopeUid())
        || isGrantedProfessional(resource.data);

      // Only admin and manager can create/update tasks
      allow create, update: if isAdminOrManager();

      // Only admin can delete tasks
      allow delete: if isAdmin();

      // ── tasks/{taskId}/steps/{stepId} ────────────────────────────────────
      match /steps/{stepId} {
        allow read: if isAdminOrManager()
          || (isSignedIn() && role() == 'team_member' && get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedTo == request.auth.uid)
          || (isSignedIn() && role() == 'client' && get(/databases/$(database)/documents/tasks/$(taskId)).data.clientUid == clientScopeUid())
          || isGrantedProfessional(get(/databases/$(database)/documents/tasks/$(taskId)).data);
        allow write: if isAdminOrManager();
      }

      // ── tasks/{taskId}/payments/{paymentId} ──────────────────────────────
      // #148: the matter's payment ledger — one doc per instalment received.
      // Admin/manager ONLY: a team member must not see payment information at
      // all (not even on a matter assigned to them), and neither must the
      // client. Writes go through the backend Admin SDK, which bypasses rules;
      // this denies any direct client-SDK write.
      match /payments/{paymentId} {
        allow read: if isAdminOrManager();
        allow write: if false;
      }
    }

    // ── workflowTemplates/{workflowId} ─────────────────────────────────────
    match /workflowTemplates/{workflowId} {
      // All authenticated portal users can read templates (needed to render step titles)
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /steps/{stepNumber} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // ── payments ──────────────────────────────────────────────────────────
    // NOTE: There is no top-level `payments` collection. Payments live under
    // `users/{uid}/payments/{txnId}` — see the rule inside the users match above.
    // Any top-level /payments doc is denied by the catch-all at the bottom.

    // ── notifications/{notifId} ───────────────────────────────────────────
    match /notifications/{notifId} {
      // Users can only read their own notifications
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      // Only backend (admin SDK) creates notifications — no client write
      allow create, delete: if false;
    }

    // ── Deny everything else ───────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
