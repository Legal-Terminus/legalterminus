# Firebase configuration (get from Firebase Console → Project Settings → Your Apps)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=legal-terminus-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=legal-terminus-web
VITE_FIREBASE_STORAGE_BUCKET=legal-terminus-web.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
VITE_FIREBASE_APP_ID=your-app-id-here

# Backend API base URL
# Local dev: http://localhost:5001
# Production: https://legal-terminus-qa-<hash>-uc.a.run.app
VITE_API_BASE_URL=http://localhost:5001
