# E2E test config — copy to e2e/.env.e2e and fill in.
# Use THROWAWAY accounts on the dev/QA Firebase project, NOT production users.
# e2e/.env.e2e is gitignored.

# Where the Portal is served (note the /portal/ base path).
E2E_BASE_URL=http://localhost:5173/portal/

# Staff account (admin or manager) — uploads-as-staff + reviews documents.
E2E_STAFF_EMAIL=staff@example.com
E2E_STAFF_PASSWORD=change-me

# Client account that OWNS at least one matter (uploads + re-uploads on it).
E2E_CLIENT_EMAIL=client@example.com
E2E_CLIENT_PASSWORD=change-me

# A matter (task) id to run the document flow against. The client above must own
# it, and the staff above must be able to see/review it. Find it in the URL when
# you open the matter: /portal/tasks/<THIS_ID>
E2E_TASK_ID=
