// E29: the App target's Debug settings. CocoaPods' settings first, then this build's
// environment (bundle id, display name, link host, Google URL scheme), which
// MobileShared/scripts/app-env.mjs writes on every `npm run sync` (in iOSApp/). If Environment.xcconfig
// is missing, the build fails on purpose: run `npm run sync:qa` or
// `npm run sync:production` first. docs/mobile-release.md.
#include "../Pods/Target Support Files/Pods-App/Pods-App.debug.xcconfig"
#include "Environment.xcconfig"
#include "Shared.xcconfig"
